def combo_label(CARD_NAME, DMA_TYPE, PCIE_CONF) {
    def parts = []
    if (DMA_TYPE)  parts.add("DMA_TYPE=$DMA_TYPE")
    if (PCIE_CONF) parts.add("PCIE_CONF=$PCIE_CONF")
    return parts ? "${CARD_NAME} (${parts.join(', ')})" : CARD_NAME
}

def common_card_test_run(CARD_NAME, failed, DMA_TYPE = null, PCIE_CONF = null, label = null) {
    label = label ?: combo_label(CARD_NAME, DMA_TYPE, PCIE_CONF)
    def extraArgs = []
    if (DMA_TYPE)  extraArgs.add("DMA_TYPE=$DMA_TYPE")
    if (PCIE_CONF) extraArgs.add("PCIE_CONF=$PCIE_CONF")
    def makeArgs = extraArgs.join(" ")

    try {
        sh """
        source venv-fpga/bin/activate
        make -C apps/minimal/tests/cocotb CARD=$CARD_NAME SIM_FLAGS=\"-c -do quit\" BMC_ENABLE=0 $makeArgs
        """
    } catch (err) {
        echo "Error detected, firmware build failed for $label!"
        currentBuild.result = 'FAILURE'
        currentStage.result = 'FAILURE'
        failed.add("$label")
        return
    }

    // Run junit step to record test results
    def testResult = junit allowEmptyResults: false, testResults: "apps/minimal/build/$CARD_NAME/results.xml"

    // Track failed tests based on actual test results
    if (testResult.failCount > 0) {
        echo "Tests failed for $label (${testResult.failCount} failures), build marked as UNSTABLE"
        currentBuild.result = 'UNSTABLE'
        currentStage.result = 'UNSTABLE'
        failed.add("$label")
    }
}

// (CARD, DMA_TYPE, PCIE_CONF) combinations to test, DMA_TYPE/PCIE_CONF are optional and
// fall back to the card's defaults when omitted. Keys match the make variable names
// directly. Kept as JSON so it can be parsed easily outside of Groovy too.
def COMBINATIONS_JSON = '''
[
    {"CARD": "alveo-u200"},
    {"CARD": "alveo-u55c"},
    {"CARD": "vcu118"},
    {"CARD": "ia-420f"},
    {"CARD": "n6010"},
    {"CARD": "fb2cghh"},
    {"CARD": "fb4cgg3"},
    {"CARD": "fb2cdg1"},
    {"CARD": "nfb-200g2ql"},
    {"CARD": "dk-dev-1sdx-p"},
    {"CARD": "g35p"},
    {"CARD": "nt200a02"},
    {"CARD": "agi-fh400g"},
    {"CARD": "a2700"},
    {"CARD": "ia-440i"},
    {"CARD": "fb2cghh", "DMA_TYPE": "4"},
    {"CARD": "ia-440i", "PCIE_CONF": "1xGen5x16"}
]
'''

def COMBINATIONS = new groovy.json.JsonSlurperClassic().parseText(COMBINATIONS_JSON)

node("preklad") {
    currentBuild.result = 'SUCCESS'

    cleanWs()
    checkout scm

    if (params.nightly != null && params.nightly == true) {
        stage("Prepare for nightly build") {
            sh "(cd extra/nfb-200g2ql; git checkout main)"
            sh "(cd extra/dma-medusa; git checkout main)"
        }
    }

    stage("Prepare environment") {
        sh """
            source ./env.sh
            ndk_fpga_venv_prepare "venv-fpga"
            pip install apps/minimal/tests/cocotb
        """
    }

    def failed = []

    for (combo in COMBINATIONS) {
        def card_name = combo.CARD
        def label = combo_label(card_name, combo.DMA_TYPE, combo.PCIE_CONF)
        try {
            timeout(time: 1, unit: 'HOURS') {
                stage("Run test: $label") {
                    common_card_test_run(card_name, failed, combo.DMA_TYPE, combo.PCIE_CONF, label)
                }
            }
        } catch(err) {
            echo "Error detected, test stage failed for $label!"
            currentBuild.result = 'FAILURE'
            failed.add("$label")
        }
    }

    sh "rm -rf venv-fpga"

    // send out emails if failure is detected (FAILURE or UNSTABLE)
    if(currentBuild.result == "FAILURE" || currentBuild.result == "UNSTABLE") {
        println "FAILED on cards: ${failed}."
        emailext \
            recipientProviders: [culprits(), developers()],
            to: 'cabal@cesnet.cz, spinler@cesnet.cz, isa@cesnet.cz, kondys@cesnet.cz, friedl@cesnet.cz',
            subject: "[Jenkins] ${currentBuild.result} ${env.JOB_NAME} #${currentBuild.number}",
            body: """\
                The build of the repository ${env.JOB_NAME} #${currentBuild.number} ends up with status ${currentBuild.result} on cards: ${failed}. You can find build log in the attachments.

                For more details see ${env.BUILD_URL}.

                Yours sincerely
                Jenkins\
            """.stripIndent(),
            attachLog: true,
            compressLog: true
    }
}
