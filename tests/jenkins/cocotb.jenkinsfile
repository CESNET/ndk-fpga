// Clean previous builds
library 'liberouter'
cleanBuilds()

// Run component verifications using common script
node('preklad') {
    lock(label:"resources-${env.NODE_NAME}", quantity: 1) {
        // fetch sources from GIT
        checkout scm
        def common_run = load "tests/jenkins/common.jenkins"

        // INCLUDE and EXCLUDE act as a filters of automatically detected cocotb tests.
        // Filtering is done by names of folders in the path to the tests.
        // Operations 'and' (&) and 'or' (|) are also supported, however
        // you use only ands or only ors.
        def INCLUDE = ""           // "" for include all
        def EXCLUDE = "apps|pyuvm" // "" for exclude none

        // /////////////////////////////////////////////////////////////////////////////
        // BASIC-VERIFICATION
        // /////////////////////////////////////////////////////////////////////////////
        // Add engines for automatic Jenkins verifications into the following list
        // FORMAT:
        //  [ 'name', 'path_to_ver'],
        // /////////////////////////////////////////////////////////////////////////////
        def COMPONENTS_VER = common_run.fetchCocotbCompsVer(INCLUDE, EXCLUDE)
        // /////////////////////////////////////////////////////////////////////////////

        // /////////////////////////////////////////////////////////////////////////////
        // MULTI-VERIFICATION
        // /////////////////////////////////////////////////////////////////////////////
        // Add engines for automatic Jenkins verifications into the following list
        // FORMAT:
        //  [ 'name', 'path_to_ver', 'settings.py']
        def COMPONENTS_MULTIVER = common_run.fetchCocotbCompsMultiVer(INCLUDE, EXCLUDE)
        // /////////////////////////////////////////////////////////////////////////////

        common_run.commonPrekladCocotbVerRun(COMPONENTS_VER)
        common_run.commonPrekladCocotbMultiVerRun(COMPONENTS_MULTIVER)
    }
}
