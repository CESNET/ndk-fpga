// Clean previous builds
library 'liberouter'
cleanBuilds()

// Run component verifications using common script
node('preklad') {
    lock(label:"resources-${env.NODE_NAME}", quantity: 1) {
        // fetch sources from GIT
        checkout scm
        def common_run = load "tests/jenkins/common.jenkins"

        def CATEGORY = ""

        // /////////////////////////////////////////////////////////////////////////////
        // BASIC-VERIFICATION
        // /////////////////////////////////////////////////////////////////////////////
        // Add engines for automatic Jenkins verifications into the following list
        // FORMAT:
        //  [ 'name', 'path_to_ver'],
        // /////////////////////////////////////////////////////////////////////////////
        def COMPONENTS_VER = common_run.fetchCocotbCompsVer(CATEGORY)
        // /////////////////////////////////////////////////////////////////////////////

        // /////////////////////////////////////////////////////////////////////////////
        // MULTI-VERIFICATION
        // /////////////////////////////////////////////////////////////////////////////
        // Add engines for automatic Jenkins verifications into the following list
        // FORMAT:
        //  [ 'name', 'path_to_ver', 'settings.py']
        def COMPONENTS_MULTIVER = common_run.fetchCocotbCompsMultiVer(CATEGORY)
        // /////////////////////////////////////////////////////////////////////////////

        common_run.commonPrekladCocotbVerRun(COMPONENTS_VER)
        common_run.commonPrekladCocotbMultiVerRun(COMPONENTS_MULTIVER)
    }
}
