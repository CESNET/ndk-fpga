library 'liberouter'

// Jenkins configuration for multiple modules
def commonPrekladVerRun(COMPONENTS) {

    // Clean old builds from Jenkins history
    cleanBuilds()

    // clean artifacts possibly left by previous builds
    sh "git clean -df"

    // every midnight check for new commits and run pipeline if they exist
    properties([pipelineTriggers([pollSCM('H H(0-2) * * *')])])

    def failed = []
    //load new fpga_version and set default simulator
    def print_info = "hostname;"
        print_info += "git --no-pager log -n 1;"
    def toolsel  = "set +x\n"
        toolsel += "source fpga_version.sh\n"
        toolsel += "fpga_sim -d\n"
        toolsel += "set -x\n"

    // run verification of every component
    for(c in COMPONENTS) {
        // parse
        def name = c[0]
        def path = c[1]
        def script = c[2]
        // exec vsim
        try { // try-catch is a hack to continue even after the first failed verification
            timeout(time: 4, unit: 'HOURS') {
                stage("$name") {
                    dir("$path") {
                        def command = "vsim -c -do \"do $script; quit -f\" | grep -E \"(Verification finished successfully)|(VERIFICATION SUCCESS)\"\n"
                        // "quit -f" added to ensure termination of vsim execution in all cases
                        // grep used to detect successfull run, each verification should have the following line before the last $stop:
                        //    $write("Verification finished successfully!\n");
                        //
                        sh "${print_info}"
                        sh "${toolsel}${command}"
                    }
                }
            }
        } catch(err) {
            currentBuild.result = 'FAILURE' // still propagate failure status to Jenkins
            failed.add("$name")
        } finally { // collect interesting files
            archiveArtifacts "$path/transcript" // verification log
            if(currentBuild.result == "FAILURE") {
                archiveArtifacts "$path/vsim.wlf" // generated waveform, use vsim -view vsim.wlf
            }
        }
    }

    // send out emails if failure is detected
    if(currentBuild.result == "FAILURE") {
        println "FAILED on components: ${failed}."
        emailext \
            recipientProviders: [culprits(), developers()],
            to: 'cabal@cesnet.cz,isa@cesnet.cz',
            subject: "[Jenkins] ${currentBuild.currentResult} ${env.JOB_NAME} #${currentBuild.number}",
            body: """\
                The build of the repository ${env.JOB_NAME} #${currentBuild.number} ends up with status ${currentBuild.currentResult} on components: ${failed}. You can find build log in the attachments.

                For more details see ${env.BUILD_URL}.

                Yours sincerely
                Jenkins\
            """.stripIndent(),
            attachLog: true,
            compressLog: true
    }
}

// Jenkins configuration for MultiVer
def commonPrekladMultiVerRun(COMPONENTS, ofm_path = pwd()) {

    // Clean old builds from Jenkins history
    cleanBuilds()

    // fetch sources from GIT
    checkout scm
    // clean artifacts possibly left by previous builds
    sh "git clean -df"

    // every midnight check for new commits and run pipeline if they exist
    properties([pipelineTriggers([pollSCM('H H(0-2) * * *')])])
    properties([
        parameters([
            booleanParam(name: 'FORCE_RUN_COVERAGE_REPORT', defaultValue: (params.FORCE_RUN_COVERAGE_REPORT ?: false))
        ])
    ])

    def run_coverage_report = (
        params.FORCE_RUN_COVERAGE_REPORT || // Used for manually triggered jobs
        ['devel'].contains(env.BRANCH_NAME) // Used for automatically triggered jobs
    )

    def failed = []
    //load new fpga_version and set default simulator
    def print_info = "hostname;"
        print_info += "git --no-pager log -n 1;"
    def toolsel  = "set +x\n"
        toolsel += "source fpga_version.sh\n"
        toolsel += "fpga_sim -d\n"
        toolsel += "set -x\n"

    // run verification of every component
    for(c in COMPONENTS) {
        // parse
        def name      = c[0]
        def path      = c[1]
        def fdo       = c[2]
        def pkg       = c[3]
        def settings  = c[4]
        //def repo_root = pwd()
        //def multi_ver = "$repo_root/build/scripts/multi_ver/multi_ver.py"
        def multi_ver = "$ofm_path/build/scripts/multi_ver/multi_ver.py"
        def coverage_reporter = "$ofm_path/python/coverage_reporter/coverage_reporter.py"
        // exec vsim
        try { // try-catch is a hack to continue even after the first failed verification
            timeout(time: 4, unit: 'HOURS') {
                stage("$name") {
                    dir("$path") {
                        def command = "python3 $multi_ver $fdo $pkg $settings -p \"$name\""
                        if (run_coverage_report) {
                            command = "$command --coverage"
                        }
                        sh "${print_info}"
                        sh "${toolsel}${command}"
                    }
                }
            }
        } catch(err) {
            currentBuild.result = 'FAILURE' // still propagate failure status to Jenkins
            failed.add("$name")
        } finally { // collect interesting files
            archiveArtifacts "$path/transcript*" // verification log
            if (run_coverage_report) {
                // Generate a coverage report file
                sh(
                    script: "python3 ${coverage_reporter} --name \"$name\" --input \"$path/coverage_merged.ucdb\" --output \"$path/coverage_report.json\"",
                    returnStatus: true,
                    returnStdout: false,
                )
            }
            if(currentBuild.result == "FAILURE") {
                archiveArtifacts "$path/vsim.wlf"   // generated waveform, use vsim -view vsim.wlf
            }
        }
    }

    // send out emails if failure is detected
    if(currentBuild.result == "FAILURE") {
        println "FAILED on components: ${failed}."
        emailext \
            recipientProviders: [culprits(), developers()],
            to: 'cabal@cesnet.cz,isa@cesnet.cz',
            subject: "[Jenkins] ${currentBuild.currentResult} ${env.JOB_NAME} #${currentBuild.number}",
            body: """\
                The build of the repository ${env.JOB_NAME} #${currentBuild.number} ends up with status ${currentBuild.currentResult} on components: ${failed}. You can find build log in the attachments.

                For more details see ${env.BUILD_URL}.

                Yours sincerely
                Jenkins\
            """.stripIndent(),
            attachLog: true,
            compressLog: true
    }

    if (run_coverage_report) {
        // Publish the coverage report file
        publishReport displayType: 'absolute', name: 'Coverage Report', provider: json(pattern: '**/coverage_report*.json')
    }
}

def commonPrekladHarpRun(COMPONENTS, ofm_path = pwd()) {
    // Clean old builds from Jenkins history
    cleanBuilds()

    // fetch sources from GIT
    checkout scm
    // clean artifacts possibly left by previous builds
    sh "git clean -df"

    // every midnight check for new commits and run pipeline if they exist
    properties([pipelineTriggers([pollSCM('H H(0-2) * * *')])])

    def failed = []
    //load new fpga_version and set default simulator
    def print_info = "hostname;"
        print_info += "git --no-pager log -n 1;"
    def toolsel  = "set +x\n"
    toolsel += "source fpga_version.sh\n"
    toolsel += "fpga_sim -d\n"
    toolsel += "set -x\n"

    def venv_dir = "$ofm_path/python/harp/harp_venv"

    // prepare virtual environment with HARP
    stage("Prepare virtual env") {
        sh """
        if ! command -v python3.9; then
            echo "Python 3.9 is not installed. Please install Python 3.9."
            exit 1
        fi
        python3.9 -m venv $venv_dir
        source $venv_dir/bin/activate
        pip install --upgrade pip
        pip install $ofm_path/python/harp
        """
    }

    def env_source = "source $venv_dir/bin/activate\n"

    for(c in COMPONENTS) {
        // parse
        def name      = c[0]
        def path      = c[1]

        // exec vsim
        try { // try-catch is a hack to continue even after the first failed verification
            timeout(time: 4, unit: 'HOURS') {
                stage("$name") {
                    dir("$path") {
                        def command = "harp multiver"
                        sh "${print_info}"
                        sh "${env_source}${toolsel}${command}"
                    }
                }
            }
        } catch(err) {
            currentBuild.result = 'FAILURE' // still propagate failure status to Jenkins
            failed.add("$name")
        } finally { // collect interesting files
            // there is unknown path to transcripts folder
            // archiveArtifacts "$path/transcript*"
            if(currentBuild.result == "FAILURE") {
                archiveArtifacts "$path/failed_combinations.csv" // failed combinations summary with seed
            // there is unknown path to wave folder
                // archiveArtifacts "$path/vsim.wlf"
            }
        }
    }

    // send out emails if failure is detected
    if(currentBuild.result == "FAILURE") {
        println "FAILED on components: ${failed}."
        emailext \
            recipientProviders: [culprits(), developers()],
            to: 'cabal@cesnet.cz,isa@cesnet.cz',
            subject: "[Jenkins] ${currentBuild.currentResult} ${env.JOB_NAME} #${currentBuild.number}",
            body: """\
                The build of the repository (with HARP) ${env.JOB_NAME} #${currentBuild.number} ends up with status ${currentBuild.currentResult} on components: ${failed}. You can find build log in the attachments.

                For more details see ${env.BUILD_URL}.

                Yours sincerely
                Jenkins\
            """.stripIndent(),
            attachLog: true,
            compressLog: true
    }
}

def isInPath(path, keyword) {
    def result = false

    if (keyword.contains("&")) {
        def symbList = keyword.split("&")

        result = true

        symbList.each { symbol ->
            if (!path.contains(symbol) ) {
                result = false
            }
        }
    } else if (keyword.contains("|")) {
        def symbList = keyword.split("\\|")

        symbList.each { symbol ->
            if (path.contains(symbol)) {
                result = true
            }
        }
    } else {
        result = path.contains(keyword)
    }

    return result
}

def fetchCocotbCompsVer(include = "", exclude = []) {
    def test_paths = sh(script: "find . -name 'cocotb_test.py' -exec dirname {} + | cut -c3-", returnStdout: true).trim()
    def comps_ver = []

    test_paths.readLines().each { path ->
        if (isInPath(path, include)) {
            def comp_name = sh(script: "grep '^TOP_LEVEL_ENT=' $path/Makefile | cut -d'=' -f2", returnStdout: true).trim()

            if (comp_name.length() > 0 && !exclude.contains(comp_name) && comp_name != '%s') {
                comps_ver.add([comp_name, path])
            }
        }
    }

    return comps_ver
}

def fetchCocotbCompsMultiVer(include = "", exclude = []) {
    def comps_ver = fetchCocotbCompsVer(include, exclude)
    def comps_multiver = []

    comps_ver.each { comp ->
        def name = comp[0]
        def path = comp[1]

        dir ("$path") {
            def settings_paths = sh(script: "find .. -name 'ver_settings.py' | cut -c3-", returnStdout: true).trim()

            if (settings_paths.length() > 0) {
                settings_paths = settings_paths.readLines()

                settings_paths.each { settings_path ->
                    def relative_path = "..$settings_path"

                    if (settings_paths.size() > 1) {
                        dir_name = settings_path.split("/")[-2]
                        comps_multiver.add(["$name - $dir_name", path, relative_path])
                    } else {
                        comps_multiver.add([name, path, relative_path])
                    }
                }
            }
        }
    }

    return comps_multiver
}

def commonPrekladCocotbVerRun(COMPONENTS) {

    // Clean old builds from Jenkins history
    cleanBuilds()

    // clean artifacts possibly left by previous builds
    sh "git clean -df"

    // every midnight check for new commits and run pipeline if they exist
    properties([pipelineTriggers([pollSCM('H H(0-2) * * *')])])

    // get info about the server and name of the last commit
    def print_info = "hostname;"
        print_info += "git --no-pager log -n 1;"

    def failed = []

    // run verification of every component
    for(c in COMPONENTS) {
        // parse
        def name = c[0]
        def path = c[1]

        // exec vsim
        try { // try-catch is a hack to continue even after the first failed verification
            timeout(time: 4, unit: 'HOURS') {
                stage("cocotb (VER): $name") {
                    dir("$path") {
                        try {
                            def command = ""

                            // activate virtual environment if present
                            if (fileExists('pyproject.toml')) {
                                command += "make cocotb-venv\nsource venv-$name/bin/activate\n"
                            }

                            // run verification
                            command += "make TARGET=cocotb SIM_FLAGS=\"-c -do quit\""
                            sh "${print_info}"
                            sh "$command"

                        } catch (err) {
                            echo "Error detected, firmware build failed!"
                            currentBuild.result = 'FAILURE'
                            currentStage.result = 'FAILURE'
                            failed.add("$name")
                        }

                        // get test results
                        junit allowEmptyResults: true, testResults: "results.xml"

                        try {
                            sh "test -f results.xml"
                        } catch (err) {
                            echo "Error detected, no tests performed (results missing)!"
                            currentBuild.result = 'FAILURE'
                            currentStage.result = 'FAILURE'
                            failed.add("$name")
                        }
                    }
                }
            }
        } catch(err) {
            currentBuild.result = 'FAILURE' // still propagate failure status to Jenkins
            failed.add("$name")
        } finally { // collect interesting files
            archiveArtifacts "$path/transcript" // verification log
            if(currentBuild.result == "FAILURE") {
                archiveArtifacts "$path/vsim.wlf" // generated waveform, use vsim -view vsim.wlf
            }
        }
    }

    // send out emails if failure is detected
    if(currentBuild.result == "FAILURE") {
        println "FAILED on components: ${failed}."
        emailext \
            recipientProviders: [culprits(), developers()],
            to: 'ondrejschwarz@cesnet.cz',
            subject: "[Jenkins] ${currentBuild.currentResult} ${env.JOB_NAME} #${currentBuild.number}",
            body: """\
                The build of the repository ${env.JOB_NAME} #${currentBuild.number} ends up with status ${currentBuild.currentResult} on components: ${failed}. You can find build log in the attachments.

                For more details see ${env.BUILD_URL}.

                Yours sincerely
                Jenkins\
            """.stripIndent(),
            attachLog: true,
            compressLog: true
    }
}

def commonPrekladCocotbMultiVerRun(COMPONENTS, ofm_path = pwd()) {

    // Clean old builds from Jenkins history
    cleanBuilds()

    // clean artifacts possibly left by previous builds
    sh "git clean -df"

    // every midnight check for new commits and run pipeline if they exist
    properties([pipelineTriggers([pollSCM('H H(0-2) * * *')])])

    // get info about the server and name of the last commit
    def print_info = "hostname;"
        print_info += "git --no-pager log -n 1;"

    def failed = []

    // run verification of every component
    for(c in COMPONENTS) {
        // parse
        def name     = c[0]
        def path     = c[1]
        def settings = c[2]

        def multi_ver = "$ofm_path/build/scripts/multi_ver/multi_ver_cocotb.py"

        // exec vsim
        try { // try-catch is a hack to continue even after the first failed verification
            timeout(time: 4, unit: 'HOURS') {
                stage("cocotb (MULTIVER): $name") {
                    dir("$path") {
                        try {
                            // run multi ver script for cocotb
                            def command = "python3 $multi_ver $settings"
                            sh "${print_info}"
                            sh "$command"

                        } catch (err) {
