set_instance_assignment -name VIRTUAL_PIN ON -to CLK_NOC_TOP

set_instance_assignment -name VIRTUAL_PIN ON -to CLK_UIB1_FBR1_P
set_instance_assignment -name VIRTUAL_PIN ON -to CLK_UIB1_P

set_instance_assignment -name VIRTUAL_PIN ON -to HBM_TOP_CATTRIP_VIRTUAL
set_instance_assignment -name VIRTUAL_PIN ON -to HBM_TOP_TEMP_VIRTUAL
