# ==============================================================================
#  QSFP0-DD Misc signals
# ==============================================================================

set_location_assignment PIN_FJ2 -to QSFP0_MODPRS_N
set_location_assignment PIN_FH1 -to QSFP0_INT_N
set_location_assignment PIN_FL4 -to QSFP0_RST_N
set_location_assignment PIN_FM3 -to QSFP0_LPMODE
set_location_assignment PIN_FM1 -to QSFP0_I2C_SCL
set_location_assignment PIN_FL2 -to QSFP0_I2C_SDA

set_location_assignment PIN_FR6 -to QSFP0_LED_R
set_location_assignment PIN_FL6 -to QSFP0_LED_G
set_location_assignment PIN_FF1 -to QSFP0_LED_B

set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_I2C_SCL
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_I2C_SDA
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_MODPRS_N
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_INT_N
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_RST_N

set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_LED_R
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_LED_G
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP0_LED_B

# ==============================================================================
#  QSFP1-DD Misc signals
# ==============================================================================

set_location_assignment PIN_FE4 -to QSFP1_MODPRS_N
set_location_assignment PIN_FF3 -to QSFP1_INT_N
set_location_assignment PIN_FR4 -to QSFP1_RST_N
set_location_assignment PIN_FP3 -to QSFP1_LPMODE

set_location_assignment PIN_FR2 -to QSFP1_I2C_SCL
set_location_assignment PIN_FP1 -to QSFP1_I2C_SDA

set_location_assignment PIN_FP5 -to QSFP1_LED_R
set_location_assignment PIN_FM5 -to QSFP1_LED_G
set_location_assignment PIN_FE2 -to QSFP1_LED_B

set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_I2C_SCL
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_I2C_SDA
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_MODPRS_N
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_INT_N
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_RST_N

set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_LED_R
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_LED_G
set_instance_assignment -name IO_STANDARD "1.2 V" -to QSFP1_LED_B
