set_instance_assignment -name VIRTUAL_PIN ON -to CLK_NOC_BOTTOM

set_instance_assignment -name VIRTUAL_PIN ON -to CLK_UIB0_FBR0_P
set_instance_assignment -name VIRTUAL_PIN ON -to CLK_UIB0_P

set_instance_assignment -name VIRTUAL_PIN ON -to HBM_BOT_CATTRIP_VIRTUAL
set_instance_assignment -name VIRTUAL_PIN ON -to HBM_BOT_TEMP_VIRTUAL
