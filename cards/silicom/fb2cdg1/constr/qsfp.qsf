# # "QSFPDD0" on schematic farthest from edge goldfingers
set_location_assignment PIN_BE14 -to QSFP0_REFCLK_P -comment IOBANK_13C

set_location_assignment PIN_AP1  -to QSFP0_RX_P[7]
set_location_assignment PIN_AR2  -to QSFP0_RX_N[7]
set_location_assignment PIN_BA4  -to QSFP0_RX_P[6]
set_location_assignment PIN_AY5  -to QSFP0_RX_N[6]
set_location_assignment PIN_AV1  -to QSFP0_RX_P[5]
set_location_assignment PIN_AW2  -to QSFP0_RX_N[5]
set_location_assignment PIN_BE4  -to QSFP0_RX_P[4]
set_location_assignment PIN_BD5  -to QSFP0_RX_N[4]
set_location_assignment PIN_BB1  -to QSFP0_RX_P[3]
set_location_assignment PIN_BC2  -to QSFP0_RX_N[3]
set_location_assignment PIN_BJ4  -to QSFP0_RX_P[2]
set_location_assignment PIN_BH5  -to QSFP0_RX_N[2]
set_location_assignment PIN_BF1  -to QSFP0_RX_P[1]
set_location_assignment PIN_BG2  -to QSFP0_RX_N[1]
set_location_assignment PIN_BK1  -to QSFP0_RX_P[0]
set_location_assignment PIN_BL2  -to QSFP0_RX_N[0]
set_location_assignment PIN_AV7  -to QSFP0_TX_P[7]
set_location_assignment PIN_AW8  -to QSFP0_TX_N[7]
set_location_assignment PIN_BA10 -to QSFP0_TX_P[6]
set_location_assignment PIN_AY11 -to QSFP0_TX_N[6]
set_location_assignment PIN_BB7  -to QSFP0_TX_P[5]
set_location_assignment PIN_BC8  -to QSFP0_TX_N[5]
set_location_assignment PIN_BE10 -to QSFP0_TX_P[4]
set_location_assignment PIN_BD11 -to QSFP0_TX_N[4]
set_location_assignment PIN_BF7  -to QSFP0_TX_P[3]
set_location_assignment PIN_BG8  -to QSFP0_TX_N[3]
set_location_assignment PIN_BJ10 -to QSFP0_TX_P[2]
set_location_assignment PIN_BH11 -to QSFP0_TX_N[2]
set_location_assignment PIN_BK7  -to QSFP0_TX_P[1]
set_location_assignment PIN_BL8  -to QSFP0_TX_N[1]
set_location_assignment PIN_BP7  -to QSFP0_TX_P[0]
set_location_assignment PIN_BR8  -to QSFP0_TX_N[0]

#"QSFPDD1" on schematic closest to edge goldfingers
set_location_assignment PIN_DJ14 -to QSFP1_REFCLK_P -comment IOBANK_13A

set_location_assignment PIN_DK1  -to QSFP1_RX_P[7]
set_location_assignment PIN_DL4  -to QSFP1_RX_P[6]
set_location_assignment PIN_DP1  -to QSFP1_RX_P[5]
