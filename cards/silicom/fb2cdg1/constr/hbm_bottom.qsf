set_location_assignment PIN_EE56 -to CLK_NOC_BOTTOM

set_instance_assignment -name IO_STANDARD "1.8-V" -to CLK_NOC_BOTTOM
set_instance_assignment -name INPUT_TERMINATION OFF -to CLK_NOC_BOTTOM

set_location_assignment PIN_EH37 -to CLK_UIB0_FBR0_P
set_location_assignment PIN_EC36 -to CLK_UIB0_P

set_instance_assignment -name VIRTUAL_PIN ON -to HBM_BOT_CATTRIP_VIRTUAL
set_instance_assignment -name VIRTUAL_PIN ON -to HBM_BOT_TEMP_VIRTUAL

set_instance_assignment -name IO_STANDARD "1.2V TRUE DIFFERENTIAL SIGNALING" -to CLK_UIB0_FBR0_P
set_instance_assignment -name IO_STANDARD "1.2V TRUE DIFFERENTIAL SIGNALING" -to CLK_UIB0_P
set_instance_assignment -name INPUT_TERMINATION DIFFERENTIAL -to CLK_UIB0_FBR0_P

set_instance_assignment -name IO_STANDARD "1.2-V" -to HBM_BOT_CATTRIP_VIRTUAL
set_instance_assignment -name SLEW_RATE 1 -to HBM_BOT_CATTRIP_VIRTUAL
set_instance_assignment -name IO_STANDARD "1.2-V" -to HBM_BOT_TEMP_VIRTUAL*
set_instance_assignment -name SLEW_RATE 1 -to HBM_BOT_TEMP_VIRTUAL*

