set_location_assignment PIN_AU52 -to CLK_NOC_TOP

set_instance_assignment -name IO_STANDARD "1.8-V" -to CLK_NOC_TOP
set_instance_assignment -name INPUT_TERMINATION OFF -to CLK_NOC_TOP

set_location_assignment PIN_AT41 -to CLK_UIB1_FBR1_P
set_location_assignment PIN_AR36 -to CLK_UIB1_P

set_instance_assignment -name VIRTUAL_PIN ON -to HBM_TOP_CATTRIP_VIRTUAL
set_instance_assignment -name VIRTUAL_PIN ON -to HBM_TOP_TEMP_VIRTUAL

set_instance_assignment -name IO_STANDARD "1.2V TRUE DIFFERENTIAL SIGNALING" -to CLK_UIB1_FBR1_P
set_instance_assignment -name IO_STANDARD "1.2V TRUE DIFFERENTIAL SIGNALING" -to CLK_UIB1_P
set_instance_assignment -name INPUT_TERMINATION DIFFERENTIAL -to CLK_UIB1_FBR1_P

set_instance_assignment -name IO_STANDARD "1.2-V" -to HBM_TOP_CATTRIP_VIRTUAL
set_instance_assignment -name SLEW_RATE 1 -to HBM_TOP_CATTRIP_VIRTUAL
set_instance_assignment -name IO_STANDARD "1.2-V" -to HBM_TOP_TEMP_VIRTUAL*
set_instance_assignment -name SLEW_RATE 1 -to HBM_TOP_TEMP_VIRTUAL*

