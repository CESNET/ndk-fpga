set_location_assignment PIN_BC46 -to PCIE_TX_N[8]
set_location_assignment PIN_BA46 -to PCIE_TX_N[9]
set_location_assignment PIN_AW46 -to PCIE_TX_N[10]
set_location_assignment PIN_AU46 -to PCIE_TX_N[11]
set_location_assignment PIN_AR46 -to PCIE_TX_N[12]
set_location_assignment PIN_AN46 -to PCIE_TX_N[13]
set_location_assignment PIN_AL46 -to PCIE_TX_N[14]
set_location_assignment PIN_AK44 -to PCIE_TX_N[15]

set_location_assignment PIN_BG51 -to PCIE_RX_P[0]
set_location_assignment PIN_BE51 -to PCIE_RX_P[1]
set_location_assignment PIN_BC51 -to PCIE_RX_P[2]
