set_location_assignment PIN_BA51 -to PCIE_RX_P[4]
set_location_assignment PIN_AY49 -to PCIE_RX_P[5]
set_location_assignment PIN_AW51 -to PCIE_RX_P[6]
set_location_assignment PIN_AV49 -to PCIE_RX_P[7]
set_location_assignment PIN_AU51 -to PCIE_RX_P[8]
set_location_assignment PIN_AT49 -to PCIE_RX_P[9]
