# ==============================================================================
# Pin Locations - PCIe
# ==============================================================================

set_location_assignment PIN_AK38 -to PCIE_SYSRST_N

set_location_assignment PIN_AP44 -to  PCIE_REFCLK0
set_location_assignment PIN_AP43 -to "PCIE_REFCLK0(n)"
set_location_assignment PIN_AM44 -to  PCIE_REFCLK1
set_location_assignment PIN_AM43 -to "PCIE_REFCLK1(n)"

set_location_assignment PIN_BL47 -to PCIE_TX_P[0]
set_location_assignment PIN_BK49 -to PCIE_TX_P[1]
set_location_assignment PIN_BJ47 -to PCIE_TX_P[2]
set_location_assignment PIN_BH49 -to PCIE_TX_P[3]
set_location_assignment PIN_BG47 -to PCIE_TX_P[4]
set_location_assignment PIN_BF49 -to PCIE_TX_P[5]
set_location_assignment PIN_BE47 -to PCIE_TX_P[6]
set_location_assignment PIN_BD49 -to PCIE_TX_P[7]
set_location_assignment PIN_BC47 -to PCIE_TX_P[8]
set_location_assignment PIN_BA47 -to PCIE_TX_P[9]
set_location_assignment PIN_AW47 -to PCIE_TX_P[10]
set_location_assignment PIN_AU47 -to PCIE_TX_P[11]
set_location_assignment PIN_AR47 -to PCIE_TX_P[12]
