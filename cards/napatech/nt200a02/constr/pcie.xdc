set_property PACKAGE_PIN BE4     [get_ports {PCIE_TX_N[15]}]

set_property PACKAGE_PIN AM17    [get_ports PCIE_SYSRST]
set_property PULLUP     true     [get_ports PCIE_SYSRST]
set_property IOSTANDARD LVCMOS12 [get_ports PCIE_SYSRST]

set_property PACKAGE_PIN AG9     [get_ports PCIE_SYSCLK_P]
set_property PACKAGE_PIN AG8     [get_ports PCIE_SYSCLK_N]

create_clock -period 10.000 -name pcie_clk [get_ports PCIE_SYSCLK_P]
