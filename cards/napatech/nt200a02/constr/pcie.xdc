set_property PACKAGE_PIN Y7      [get_ports {PCIE_TX_P[0]}]
set_property PACKAGE_PIN Y6      [get_ports {PCIE_TX_N[0]}]
set_property PACKAGE_PIN AB7     [get_ports {PCIE_TX_P[1]}]
set_property PACKAGE_PIN AB6     [get_ports {PCIE_TX_N[1]}]
