# cocotb and nvc build artifacts, generated in-tree next to each testbench
nvcwork/
__pycache__/
results.xml
*.vivado.mk
*.netcope_tmp/
# The component benches write theirs to a bare netcope_tmp/, which the pattern above misses.
netcope_tmp/
DevTree_paths.txt

# Waveform dumps are regenerated by any run and can reach hundreds of MB, which exceeds what a git
# hosting service accepts for a single file.
*.fst
*.fst.hier
*.ghw
*.vcd

# Vivado build output. Only the sources and the build recipe belong in the tree; the project
# the build creates is regenerated by `make` and runs to hundreds of MB per card.
apps/*/build/*/*.runs/
apps/*/build/*/*.cache/
apps/*/build/*/*.gen/
apps/*/build/*/*.hw/
apps/*/build/*/*.sim/
apps/*/build/*/*.srcs/
apps/*/build/*/*.xpr
apps/*/build/*/*.bit
apps/*/build/*/*.dcp
apps/*/build/*/*.nfw
apps/*/build/*/*.log

# Vivado per-run reports written beside the project
apps/*/build/*/*_par.*
apps/*/build/*/*_synth.*
apps/*/build/*/messages-*.txt

# editor and scratch leftovers
*.bak
*.bak-*
*.orig
*.rej
*~
