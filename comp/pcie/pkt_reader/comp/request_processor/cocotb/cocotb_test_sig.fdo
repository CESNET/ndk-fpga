view wave
delete wave *

add_wave -group {PPR Req Proc} -noupdate -hex /ppr_request_processor/*
add_wave -group {PPR DMA Uphdr Gen} -noupdate -hex /ppr_request_processor/dma_uphdr_gen_i/*


config wave -signalnamewidth 1
