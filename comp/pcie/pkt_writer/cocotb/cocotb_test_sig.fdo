view wave
delete wave *

add_wave -group {PPW Top} -noupdate -hex /pcie_pkt_writer/*
add_wave -group {PPW INSTR_GEN} -group {PAGE_BREAK_PLANNER} -noupdate -hex /pcie_pkt_writer/instr_gen_i/page_break_planner_i/*
add_wave -group {PPW INSTR_GEN} -group {MTU_BREAK_PLANNER} -noupdate -hex /pcie_pkt_writer/instr_gen_i/mtu_break_planner_i/*
add_wave -group {PPW HDR_GEN} -noupdate -hex /pcie_pkt_writer/dma_uphdr_gen_i/*
add_wave -group {PPW PKT_BREAKER} -group {AXIS FRAME_FRACTURER} -noupdate -hex /pcie_pkt_writer/packet_breaker_i/pkt_breaker_i/*
add_wave -group {PPW PKT_BREAKER} -noupdate -hex /pcie_pkt_writer/packet_breaker_i/*


config wave -signalnamewidth 1
