view wave
delete wave *

add_wave -group {TB} -noupdate -hex /axis_eth_parser_tb/*
add_wave -group {GEN} -noupdate -hex /axis_eth_parser_tb/gen_g/dut_i/*
add_wave -group {STAGE0} -noupdate -hex /axis_eth_parser_tb/gen_g/dut_i/stages_g(0)/*
add_wave -group {STAGE0_SNIF} -noupdate -hex /axis_eth_parser_tb/gen_g/dut_i/stages_g(0)/sniffer_i/*
add_wave -group {STAGE1} -noupdate -hex /axis_eth_parser_tb/gen_g/dut_i/stages_g(1)/*
add_wave -group {STAGE1_SNIF} -noupdate -hex /axis_eth_parser_tb/gen_g/dut_i/stages_g(1)/sniffer_i/*

config wave -signalnamewidth 1
