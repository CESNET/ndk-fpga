proc mi {name} {
    add_wave -group "MI" -noupdate -hex /${name}/MI_*
}

proc axis {name direction} {
    add_wave -group "${direction}_AXI" -noupdate /${name}/${direction}_AXI_*
}

view wave
delete wave *

set name "AXIS_SWITCH"

add wave -divider "SYNC"
add_wave -noupdate -color yellow -label CLK   /${name}/CLK
add_wave -noupdate -color yellow -label RESET /${name}/RESET

add wave -divider "CONFIGURATION"
mi ${name}

add wave -divider "TRAFFIC"
axis ${name} RX
axis ${name} TX

add wave -divider "INTERNAL"
add_wave -group "SIGNALS" -noupdate -hex /${name}/s_*

