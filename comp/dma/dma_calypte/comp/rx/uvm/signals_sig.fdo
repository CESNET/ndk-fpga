source "./signals.fdo"

add_wave [list -noupdate -hex -group "ALL"] sim:/testbench/dut_i/VHDL_DUT_U/*
add_wave [list -noupdate -hex -group "transaction_buffer"] sim:/testbench/dut_i/VHDL_DUT_U/transaction_buffer_i/*
add_wave [list -noupdate -hex -group "hdr_insertor"] sim:/testbench/dut_i/VHDL_DUT_U/rx_dma_hdr_insertor_i/*
add_wave [list -noupdate -hex -group "hdr_manager"] sim:/testbench/dut_i/VHDL_DUT_U/rx_dma_hdr_manager_i/*
add_wave [list -noupdate -hex -group "sw_manager"] sim:/testbench/dut_i/VHDL_DUT_U/rx_dma_sw_manager_i/*

config wave -signalnamewidth 1
