source "./signals.fdo"

add wave -divider "MFB_SHAKEDOWN"

add_wave "-noupdate -color yellow -label CLK" /testbench/CLK

all ALL /testbench/DUT_U/VHDL_DUT_U

add_wave "-noupdate -hex -group MVB_SHAKEDOWN" testbench/DUT_U/VHDL_DUT_U/mvb_shakedown_g/*
add_wave "-noupdate -hex -group MUX_SHAKEDOWN" testbench/DUT_U/VHDL_DUT_U/mux_shakedown_g/*

config wave -signalnamewidth 1
