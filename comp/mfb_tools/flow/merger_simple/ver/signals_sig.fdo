source "./signals.fdo"

add_wave "-noupdate -color yellow -label RESET"   /testbench/RESET
add_wave "-noupdate -color yellow -label CLK"     /testbench/CLK

set DUT "/testbench/DUT_U/VHDL_DUT_U"

add wave -divider "RX MFB"
add_wave "-group {RX_MFB} -noupdate -hex" $DUT/RX_MFB_*

add wave -divider "TX MFB"
add_wave "-group {TX_MFB} -noupdate -hex" $DUT/TX_MFB_*

config wave -signalnamewidth 1
