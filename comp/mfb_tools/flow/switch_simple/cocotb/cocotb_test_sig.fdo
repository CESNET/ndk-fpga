view wave
delete wave *

add_wave -group {ALL} -noupdate -hex /mfb_switch_simple/*
add_wave -group {MERGER0} -noupdate -hex /mfb_switch_simple/en_g/output_g(0)/merge_i/*
add_wave -group {MERGER1} -noupdate -hex /mfb_switch_simple/en_g/output_g(1)/merge_i/*

config wave -signalnamewidth 1
