source "./signals.fdo"

add wave -divider "MFB_FRAME_EXTENDER"

add_wave "-noupdate -color yellow -label CLK" /testbench/CLK

all ALL /testbench/DUT_U/VHDL_DUT_U

add_wave "-noupdate -hex -group USER_PACKET_GEN" testbench/DUT_U/VHDL_DUT_U/pkt_gen_i/*
add_wave "-noupdate -hex -group DM_CTRL" testbench/DUT_U/VHDL_DUT_U/dm_ctrl_i/*
add_wave "-noupdate -hex -group DATAMOVER" testbench/DUT_U/VHDL_DUT_U/data_mover_i/*
add_wave "-noupdate -hex -group DATAMOVER/FIFOX_MULTI" testbench/DUT_U/VHDL_DUT_U/data_mover_i/fifox_multi_i/*

config wave -signalnamewidth 1
