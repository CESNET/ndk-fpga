view wave
delete wave *

add_wave -group {Prepender} -noupdate -hex /mfb_mvb_prepender/*
add_wave                    -noupdate -bin /mfb_mvb_prepender/CLK
add_wave                    -noupdate -bin /mfb_mvb_prepender/RESET


config wave -signalnamewidth 1
