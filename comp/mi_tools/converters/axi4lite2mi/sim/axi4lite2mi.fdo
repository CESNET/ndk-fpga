# For whole design testing
set FIRMWARE_BASE      "../../../../.."
set AXI4LITE2MI_BASE   ".."

set TB_FILE          "$AXI4LITE2MI_BASE/sim/testbench.vhd"
set SIG_FILE         "$AXI4LITE2MI_BASE/sim/axi4lite2mi_sig.fdo"

# Modules definition
set COMPONENTS [list \
                  [list "AXI4LITE2MI" "$AXI4LITE2MI_BASE"   "FULL"] \
               ]

set SIM_FLAGS(DEBUG) true
set SIM_FLAGS(VOPT_ARGS) "+acc"

# Global include file for compilation
source "$FIRMWARE_BASE/build/Modelsim.inc.fdo"

# Suppress warnings from arithm library
puts "Std Arith Warnings - Disabled"
set StdArithNoWarnings 1
set NumericStdNoWarnings 1

# Run the simulation
nb_sim_run 5000ns
wave zoomrange 0 205ns
