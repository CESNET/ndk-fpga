# Paths
set TB_PATH     "/testbench"

# include signals
source      "signals.fdo"

add_wave -noupdate -label RESET -color magenta $TB_PATH/RESET
add_wave -noupdate -label CLK -color magenta $TB_PATH/CLK
blk_BRAM "/testbench/uut"

